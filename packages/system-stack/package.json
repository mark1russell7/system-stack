{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/system-stack",
  "version": "0.1.0",
  "description": "A system stack as data: each part is a record with its needs, a shared cause of failure is a part, and each query reads what still works.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/system-stack.git",
    "directory": "packages/system-stack"
  },
  "homepage": "https://mark1russell7.github.io/system-stack/",
  "bugs": {
    "url": "https://github.com/mark1russell7/system-stack/issues"
  },
  "keywords": [
    "system",
    "stack",
    "dependencies",
    "failure-domain",
    "single-point-of-failure",
    "risk",
    "records"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/collections": "^0.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "import": "./build/index.js",
        "default": "./build/index.js"
      },
      "./schema": {
        "types": "./build/schema.d.ts",
        "import": "./build/schema.js",
        "default": "./build/schema.js"
      },
      "./package.json": "./package.json"
    }
  }
}
