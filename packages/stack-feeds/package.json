{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/stack-feeds",
  "version": "0.1.10",
  "description": "The live lists of a system stack: each feed lists the parts of some kinds from one source, and a gate fails when a record is old or a list is old. An add-on of system-stack.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/system-stack.git",
    "directory": "packages/stack-feeds"
  },
  "homepage": "https://mark1russell7.github.io/system-stack/",
  "bugs": {
    "url": "https://github.com/mark1russell7/system-stack/issues"
  },
  "keywords": [
    "feed",
    "inventory",
    "drift",
    "freshness",
    "reconcile",
    "gate",
    "system-stack"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./add-on": "./src/add-on.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/system-stack": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "import": "./build/index.js",
        "default": "./build/index.js"
      },
      "./schema": {
        "types": "./build/schema.d.ts",
        "import": "./build/schema.js",
        "default": "./build/schema.js"
      },
      "./add-on": {
        "types": "./build/add-on.d.ts",
        "import": "./build/add-on.js",
        "default": "./build/add-on.js"
      },
      "./package.json": "./package.json"
    }
  }
}
