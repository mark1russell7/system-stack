{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/stack-spend",
  "version": "0.1.22",
  "description": "The cost of each part of a system stack as data: plans, prices and hard monthly limits, a gate, and the largest cost of a month as Vex programs. An add-on of system-stack.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/system-stack.git",
    "directory": "packages/stack-spend"
  },
  "homepage": "https://mark1russell7.github.io/system-stack/",
  "bugs": {
    "url": "https://github.com/mark1russell7/system-stack/issues"
  },
  "keywords": [
    "spend",
    "cost",
    "budget",
    "limit",
    "cap",
    "billing",
    "gate",
    "system-stack",
    "vex"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./add-on": "./src/add-on.ts",
    "./gcp-stop": "./src/gcp-stop.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/system-stack": "workspace:*",
    "@mark1russell7/vex": "^0.19.1",
    "@mark1russell7/vex-domains": "^0.19.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "import": "./build/index.js",
        "default": "./build/index.js"
      },
      "./schema": {
        "types": "./build/schema.d.ts",
        "import": "./build/schema.js",
        "default": "./build/schema.js"
      },
      "./add-on": {
        "types": "./build/add-on.d.ts",
        "import": "./build/add-on.js",
        "default": "./build/add-on.js"
      },
      "./gcp-stop": {
        "types": "./build/gcp-stop.d.ts",
        "import": "./build/gcp-stop.js",
        "default": "./build/gcp-stop.js"
      },
      "./package.json": "./package.json"
    }
  }
}
