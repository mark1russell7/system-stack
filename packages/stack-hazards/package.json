{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/stack-hazards",
  "version": "0.1.1",
  "description": "Hazard cases as reference data: the public supplies that each case can stop, each with a source, and the law of the duration of the stop or no read. An add-on of system-stack.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/system-stack.git",
    "directory": "packages/stack-hazards"
  },
  "homepage": "https://mark1russell7.github.io/system-stack/",
  "bugs": {
    "url": "https://github.com/mark1russell7/system-stack/issues"
  },
  "keywords": [
    "hazards",
    "outage",
    "supply",
    "survival-curve",
    "reference-data",
    "no-read",
    "gate",
    "system-stack"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/rigor-statistics": "^0.2.19",
    "@mark1russell7/system-stack": "workspace:*"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@mark1russell7/optional": "^1.5.0",
    "@mark1russell7/stack-endurance": "workspace:*",
    "@mark1russell7/text": "^0.0.17",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "polite-crawler": "^0.7.10",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "import": "./build/index.js",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
